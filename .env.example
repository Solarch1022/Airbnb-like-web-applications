# Application settings
APP_NAME="Example Python Backend"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS="*"

# AWS DynamoDB
AWS_REGION="us-east-1"
DYNAMODB_TABLE_NAME="items"
DYNAMODB_ACCOUNTS_TABLE_NAME="accounts"
DYNAMODB_OTP_VERIFICATIONS_TABLE_NAME="otp_verifications"
DYNAMODB_REGISTRATION_TOKENS_TABLE_NAME="registration_tokens"
DYNAMODB_SESSIONS_TABLE_NAME=sessions

JWT_SECRET_KEY=-RR4AGJqUnwBDr9YIuKZ_W77lnj5UcdPvCemKvwmirC4psZmZZp-XJtZ06-b3qPV
REGISTRATION_TOKEN_EXPIRY_MINUTES=10
REFRESH_TOKEN_EXPIRY_DAYS=30
ACCESS_TOKEN_EXPIRY_MINUTES=15
# Optional: set for DynamoDB Local, leave unset to use real AWS.
# DYNAMODB_ENDPOINT_URL="http://localhost:8000"
# Standard AWS credential env vars are also read by boto3:
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
